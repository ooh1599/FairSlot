# Public (shipped to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 5042 = Arc Mainnet (default), 5042002 = Arc Testnet
VITE_CHAIN_ID=5042
# Address of the deployed FairSlot contract on VITE_CHAIN_ID
VITE_FAIRSLOT_ADDRESS=

# Server only (Vercel functions). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: your own RPC endpoints (default: public Arc RPC)
ARC_MAINNET_RPC_URL=
ARC_TESTNET_RPC_URL=
